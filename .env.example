# LOCAL DEVELOPMENT ONLY.
#
# Speakdown is bring-your-own-key: anyone using a deployed copy enters their own
# AssemblyAI key in the app, and the deployed function in api/ has no key of its
# own. This file exists so that working on the app locally does not mean
# retyping a key on every reload.
#
# `vite dev` falls back to this value when the browser sends no key.
# `vite preview` deliberately does not, so a local preview behaves exactly like
# a real deployment.
#
# Copy this file to .env.local and fill it in. Every .env* file is gitignored,
# and this variable has no VITE_ prefix, so it is never inlined into the bundle.
# Get a key at https://www.assemblyai.com/dashboard/api-keys
ASSEMBLYAI_API_KEY=
