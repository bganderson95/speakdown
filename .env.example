# Your AssemblyAI API key: https://www.assemblyai.com/dashboard/api-keys
#
# Copy this file to .env.local and fill it in. .env.local is gitignored, and
# this variable has no VITE_ prefix so Vite never inlines it into the browser
# bundle — the dev server uses it to mint short-lived streaming tokens.
ASSEMBLYAI_API_KEY=
